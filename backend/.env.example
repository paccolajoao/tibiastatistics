PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tibiastatistics?sslmode=disable
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
FRONTEND_ORIGIN=http://localhost:3000

# Usado apenas por `go run ./cmd/seed-admin` para criar/atualizar o usuário admin padrão.
# Troque a senha em produção.
ADMIN_EMAIL=admin@tibiastatistics.local
ADMIN_PASSWORD=change-me-admin-password

# Opcionais — poller de população de mundos.
# POLLER_INTERVAL_MINUTES=15
# SNAPSHOT_RETENTION_DAYS=60

# Opcionais — poller de sincronização de bonecos (characters).
# CHARACTER_POLLER_INTERVAL_MINUTES=60
# CHARACTER_SNAPSHOT_RETENTION_DAYS=365
